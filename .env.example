# ==============================================================================
# wabill - WhatsApp Billing & Invoice Bot Configuration
# ==============================================================================

# Application Environment (development / production)
APP_ENV=production

# Application Timezone (default: Asia/Jakarta)
APP_TIMEZONE=Asia/Jakarta

# PostgreSQL Database Connection String
DATABASE_URL=postgres://postgres:postgres@postgres:5432/wabill?sslmode=disable

# Invoice Lifetime in Minutes (default: 15 minutes)
INVOICE_EXPIRATION_MINUTES=15

# Days before subscription expiration to send billing reminder (default: 3 days)
REMINDER_DAYS_BEFORE_EXPIRATION=3

# Manual Bank Transfer Payment Details
PAYMENT_BANK_NAME=BCA
PAYMENT_ACCOUNT_NUMBER=1234567890
PAYMENT_ACCOUNT_NAME=Fahad Vidjar

# Storage for uploaded payment proof screenshots
PROOF_STORAGE_PATH=/data/payment-proofs
MAX_PROOF_SIZE_MB=10

# Authorized Admin WhatsApp JIDs (comma-separated, format: [phone]@s.whatsapp.net)
# Example: 628123456789@s.whatsapp.net,628987654321@s.whatsapp.net
ADMIN_JIDS=

# Attempt sending native WhatsApp interactive buttons (fallback to text if unsupported)
ENABLE_NATIVE_BUTTONS=true
